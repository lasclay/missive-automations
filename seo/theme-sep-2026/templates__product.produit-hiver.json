            "link": "shopify://pages/milkweed-asclepiade"
          }
        },
        "template--16751310078171__49540e0f-8734-480e-b99e-776b5cbe4d97-1685564062a1b168ef-1": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/lasclay-icone-V3-monarch.png",
            "image_width": 200,
            "title": "Respectueux des monarques",
            "text": "<p>En achetant un produit Lasclay, vous aidez directement les monarques, menacés d'extinction. L'abondance d'asclépiade leur offre de précieuses aires reproductives avant leur grande migration.</p>",
            "button_label": "Découvrir le monarque",
            "link": "shopify://pages/monarch-butterfly"
          }
        }
