{"body":{"properties":{"id":"root-container","css_class":"bodyTable"},"styles":{"background_color":"#ffffff","width":600},"id":"56fdd73c054b4e858a0fac82083f5d8e","sections":[{"content_type":"section","type":"section","data":{"properties":{},"display_options":{},"styles":{"content_color_type":"template","inner_padding_bottom":0,"inner_padding_left":0,"inner_padding_right":0,"inner_padding_top":0,"stack_on_mobile":true}},"id":"7b3386e5c1d34b53802c27e250e7d940","data_id":"162aeed404f44908987095feb3fb5cf9","rows":[{"data":{"styles":{"column_layout":"1-column-full-width"}},"id":"d9e4e8c309094abbb85873bcd46a82db","data_id":"0b9aa57e8ead4afa8f46ecfa957f2c5f","columns":[{"id":"416401b969ac45679b57e84bec2f3153","data_id":"a1e2879050dc4cfdb5c4369af66b0302","data":{},"blocks":[{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:0'>Hi {{ person.first_name|default:'there' }},</p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"fa2333d14fa34c1e9e56b3e58ce4ec1c","data_id":"0c2fb55a1b524fe7a532b4ff86a19cc7"},{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:1em'>One week to the day since the Great Fall Presale opened. The dust has settled, we can breathe again, and here is where things stand.</p><p style='margin:0;padding-bottom:1em'>It is <strong>one of the best fall presales in our history</strong>. Thank you, sincerely.</p><p style='margin:0;padding-bottom:0'>What that changes, concretely: production starts from those orders. It lets us order the right quantities of fabric, thread and milkweed instead of guessing, and that is exactly why the presale exists.</p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"75a47784a2a74626bdc0020f782389bc","data_id":"2fc208dbb6104b4ea65d5fab86e5192f"},{"content_type":"block","type":"text","data":{"content":"<h3 style='color:#222;font-family:Geneva,Arial;font-size:24px;font-weight:bold;line-height:1.1;margin:0;margin-bottom:12px;text-align:left'><strong>The most popular products</strong></h3><ul><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/gants-magiques-asclepiade' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The magic gloves lined with milkweed</strong></span></a>, first by a long way.</p></li><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/milkweed-oil-body-care-trial-box' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The milkweed oil body care trial box</strong></span></a></p></li><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/recycled-plastic-milkweed-hair-clip' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The Unique Plastique x Lasclay hair clips</strong></span></a></p></li><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/embroidered-cotton-t-shirt-monarch-milkweed' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The embroidered t-shirts</strong></span></a></p></li><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/thermal-insoles' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The insulated insoles</strong></span></a></p></li><li><p style='margin:0;padding-bottom:0'><a href='https://lasclay.com/en/products/milkweed-oil-glycerin-bar-soap' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:16px;'><strong>The milkweed oil soap bars</strong></span></a></p></li></ul>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"ab89db7348f242de978f461545fba189","data_id":"186cf6068f9d419c92a661657ebc5764"},{"content_type":"block","type":"image","data":{"properties":{"dynamic":false,"alt_text":null,"asset_id":"368489485","href":null,"src":"https://d3k81ch9hvuctc.cloudfront.net/company/RhpPJR/images/6e5ceb22-16ea-4d6f-9b22-84fafac85bb3.png"},"display_options":{},"styles":{"height":937,"width":750}},"id":"01M2WFDYKQH224SQEC5Q62HRMV","data_id":"01M2WFDYKQXR4YX2Z6C7P9T8YX"},{"content_type":"block","type":"text","data":{"content":"<h3 style='color:#222;font-family:Geneva,Arial;font-size:24px;font-weight:bold;line-height:1.1;margin:0;margin-bottom:12px;text-align:left'><strong>A plant with more than one trick up its sleeve</strong></h3><p style='margin:0;padding-bottom:1em'>In a milkweed pod, <strong>the silk accounts for about 20 % of the weight</strong>. The seeds, about 30 %. <strong>For years we built the whole company on that 20 %</strong>, and the <strong>seeds went back to the field</strong>.</p><p style='margin:0;padding-bottom:1em'>This week, thanks to all of you, that changed. The products made from milkweed seed oil, not silk, are the ones that sold most: <a href='https://lasclay.com/en/products/milkweed-oil-body-care-trial-box' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;'><strong>the skincare trial box</strong></span></a>, the soap, the <a href='https://lasclay.com/en/products/milkweed-oil-eye-contour-cream-moisturizer' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;'><strong>eye contour cream made with Gourmet Sauvage</strong></span></a>, and the <a href='https://lasclay.com/en/products/recycled-plastic-milkweed-hair-clip' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;'><strong>hair clips</strong></span></a> recycled with <a href='https://www.uniqueplastique.ca/' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;'><strong>Unique Plastique</strong></span></a>, whose speckled amber colour comes from the press cake left once the oil is extracted.</p><p style='margin:0;padding-bottom:0'><span style='font-size:16px;'>We did not see that coming. It is the best news of the week: the part of the plant we did not know how to use is starting to pay for the field and support the growers too.</span></p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"521fe9962bdf4760aae300eae783c693","data_id":"7fe7176a728d45debafe7ae97fbd578b"},{"content_type":"block","type":"image","data":{"properties":{"dynamic":false,"alt_text":null,"asset_id":"94217774","href":null,"src":"https://d3k81ch9hvuctc.cloudfront.net/company/RhpPJR/images/20467cef-cb0b-4b65-8f67-3aeef1edbaba.jpeg"},"display_options":{},"styles":{"height":3200,"width":4267}},"id":"01M2WF7D923QTZC1XP50DJRK62","data_id":"01M2WF7D924B1NVK3EFS3MCZK1"},{"content_type":"block","type":"drop_shadow","data":{"display_options":{},"styles":{}},"id":"b2ad218728414108b7ce7bf6673122fb","data_id":"e0040f86fabc47faaf6f671e35b77d43"},{"content_type":"block","type":"text","data":{"content":"<h3 style='color:#222;font-family:Geneva,Arial;font-size:24px;font-weight:bold;line-height:1.1;margin:0;margin-bottom:12px;text-align:left'><strong>Our Dragons' Den appearance</strong><br/><span style='font-size:18px;'><strong>+ a surprise discount</strong></span></h3><p style='margin:0;padding-bottom:1em'>On Thursday night, in the first episode of season 21, we had nine minutes to <strong>introduce milkweed</strong> to <strong>seasoned investors</strong> who, for the most part, had <strong>never heard of it.</strong></p><p style='margin:0;padding-bottom:1em'>We talked about <strong>its silk, warmer than goose down</strong> and naturally hydrophobic. About fields that become <strong>habitat for monarchs</strong>. About the fact that <strong>Canada is the only place in the world</strong> where the plant is grown commercially. And above all, about the <strong>brave farmers who have believed in this project</strong> for more than 10 years now.</p><p style='margin:0;padding-bottom:0'><span style='font-size:16px;'>If you missed it on Thursday, the full episode is on CBC Gem. <strong>Just click the image below!</strong></span></p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"5cf597ef04424a41b2e6fb9012740657","data_id":"9a79820fb9e047f98394f41667d16722"},{"content_type":"block","type":"image","data":{"properties":{"dynamic":false,"alt_text":"Gabriel pitching Lasclay on the Dragons' Den stage, with a play button overlay.","asset_id":"372747559","href":"https://www.cbc.ca/dragonsden/episodes/season-21-episode-1","src":"https://d3k81ch9hvuctc.cloudfront.net/company/RhpPJR/images/91a3895e-9e82-4ebe-b54f-fc1885929b55.png"},"display_options":{},"styles":{"height":563,"width":1004}},"id":"01M2WENM3BWHEJ4E62TE6B81PQ","data_id":"01M2WENM3BAQEDTVZ4CK0FKNZR"},{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:1em'>&#8203;</p><p style='margin:0;padding-bottom:0'>To <strong>celebrate a milestone</strong> in the history of our company and of the milkweed industry, we are glad to offer <strong>15 % off everything, with the code DRAGONS15</strong>. Enter it in the discount field at checkout and click <strong>Apply</strong>. It is good until September 30.</p>","display_options":{},"styles":{}},"id":"01M2WEJ52TWR8MW6GBW7D5SB33","data_id":"01M2WEJ52TVV4ZRM71WRAGH6RG"},{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:0;text-align:center'><span style='font-size:22px;'><strong>&#128073; </strong></span><a href='https://lasclay.com/en/collections/produits-products' rel='noopener noreferrer nofollow' style='color:#d4ad67;text-decoration:underline' target='_blank'><span style='color:#d4ad67;font-size:22px;'><strong>SEE THE PRODUCTS AND ORDER</strong></span></a><span style='font-size:22px;'><strong> &#128072;</strong></span></p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"1a0cab3652af4ba9a8a50181afd38ae7","data_id":"39d97dc8c57b48f4929c4143b99fc0f2"},{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:1em'>Thank you so much {{ person.first_name|default:'' }} for the support. We are lucky to have a community like this one!</p><p style='margin:0;padding-bottom:1em'>Warmly,</p><p style='margin:0;padding-bottom:0'><strong>Gabriel</strong><br/>Co-founder<br/>Lasclay</p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_table_layout":"fixed"}},"id":"0d0f5abd4a0747868c82d7b0162602ca","data_id":"aba930f62ee94c1695a655d4333dcd81"},{"content_type":"block","type":"image","data":{"properties":{"dynamic":false,"alt_text":null,"asset_id":"366783603","href":null,"src":"https://d3k81ch9hvuctc.cloudfront.net/company/RhpPJR/images/212a253b-ca82-4779-b388-65e509b3be9d.jpeg"},"display_options":{},"styles":{"height":1376,"width":2064}},"id":"85acc558fae9466a89a898251d0b5a3b","data_id":"f4541fc4b86b4a1c81d6f473f83ba435"}]}]},{"data":{"styles":{"column_layout":"1-column-full-width"}},"id":"3e248b6c38f148b3bbf1b661ea85eb2c","data_id":"e28896010a0544fb9f60bb7096790588","columns":[{"id":"af8a112ea9fe406db224bd0f27adae12","data_id":"602456ec0f034a02bd8b9edcba20f78f","data":{},"blocks":[{"content_type":"block","type":"text","data":{"content":"<p style='margin:0;padding-bottom:1em'>Lasclay, 298 Boulevard des Capucins, Quebec City, QC, G1J3R4</p><p style='margin:0;padding-bottom:0'>Do not want our newsletter any more?<br/>{% unsubscribe 'Unsubscribe' %}</p>","display_options":{},"styles":{"block_padding_bottom":0,"block_padding_left":0,"block_padding_right":0,"block_padding_top":0,"color":"#727272","font_size":12,"inner_padding_bottom":9,"inner_padding_left":18,"inner_padding_right":18,"inner_padding_top":9,"mobile_stretch_content":false,"text_align":"center","text_table_layout":"fixed"}},"id":"d6cb2460a4ef4c7f830b8098e7bb2d56","data_id":"ebd2412468144deca4a242d3cf2fbd25"}]}]}]}]},"styles":[{"style_type":"base-styles","properties":{"currency":"en-CA-u-nu-latn_CAD_CA_CAD","currency_set_on_template":false,"disable_websafe_fonts":false,"mobile_optimizations":true},"styles":{