         {
          "content_type": "block",
          "type": "text",
          "data": {
           "content": "<p style=\"text-align: center;\"><span style=\"font-size: 22px;\"><strong style=\"font-weight: 700;\">👉 </strong></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://lasclay.com/collections/produits-products\" style=\"text-decoration: underline; color: rgb(212, 173, 103);\"><span style=\"color: rgb(212, 173, 103); font-size: 22px;\"><strong style=\"font-weight: 700;\">VOIR LES PRODUITS ET COMMANDER</strong></span></a><span style=\"font-size: 22px;\"><strong style=\"font-weight: 700;\"> 👈</strong></span></p>",
           "display_options": {},
           "styles": {
