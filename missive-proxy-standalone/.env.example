# Copie ce fichier en .env (local) ou reporte ces variables dans les secrets de
# ton hébergeur. NE COMMITE JAMAIS le .env rempli.

# --- Côté SERVEUR (le proxy) ---

# Jeton API Missive. Missive → Settings → API → Create token.
# Crée un jeton DÉDIÉ à ce proxy : tu pourras le révoquer sans rien casser d'autre.
MISSIVE_TOKEN=missive_pat-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe du proxy : une longue chaîne aléatoire que tu inventes.
#   openssl rand -hex 32
# C'est LUI que tu donnes à ton assistant/tes scripts — jamais le jeton Missive.
MISSIVE_PROXY_SECRET=

# Facultatif : id d'organisation Missive. Laissé vide, le proxy prend
# automatiquement la première organisation que le jeton voit (et l'affiche
# dans les logs au démarrage).
# MISSIVE_ORG=

# Facultatif : tes adresses d'envoi, séparées par des virgules. Sert à marquer
# `us: true` sur les messages sortants quand on lit un fil.
# MISSIVE_SELF_ADDRESSES=allo@exemple.com,info@exemple.com

# Port d'écoute local. Sur Render/Railway/Fly, l'hébergeur le fournit lui-même.
# PORT=3000


# --- Côté CLIENT (client.js, sur ta machine) ---

# URL publique du proxy déployé (pas un secret).
MISSIVE_PROXY_URL=https://mon-missive-proxy.onrender.com
# Le MÊME MISSIVE_PROXY_SECRET que ci-dessus.
